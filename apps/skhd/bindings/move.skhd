# move.skhd — relocate windows within a space (SRP: window movement only)
# Only within-space ops work in basic mode. Cross-space window moves
# (window --space N/prev/next) and cross-display moves need the scripting
# addition, which is broken on macOS 26 Tahoe — omitted to avoid dead binds.
#
# To move a window to another space: use macOS Mission Control (drag window to
# the desktop strip). To pin an app to a space: Dock icon > Options > Assign To.

# swap window within space (vim keys)
hyper - j : yabai -m window --swap south
hyper - k : yabai -m window --swap north
hyper - h : yabai -m window --swap west
hyper - l : yabai -m window --swap east

# warp window (re-split) within space
ctrl + alt - j : yabai -m window --warp south
ctrl + alt - k : yabai -m window --warp north
ctrl + alt - h : yabai -m window --warp west
ctrl + alt - l : yabai -m window --warp east
