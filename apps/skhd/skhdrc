# skhdrc — entrypoint. Loads binding modules (SRP: orchestration only).
# Each module owns one concern; edit the module, not this file.
# hyper = cmd + alt + ctrl + shift

.load "bindings/focus.skhd"     # focus windows / displays
.load "bindings/layout.skhd"    # reshape space
.load "bindings/move.skhd"      # move windows across space / display
.load "bindings/service.skhd"   # start / stop / restart yabai
