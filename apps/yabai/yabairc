#!/usr/bin/env bash
# yabairc — entrypoint. Loads focused modules in order (SRP: orchestration only).
# Each module owns one concern; edit the module, not this file.

config_dir="${HOME}/.config/yabai"

# NOTE: app -> space routing is NOT here. macOS 26 Tahoe + SIP-on runs yabai
# in basic mode, which cannot move windows between spaces (scripting addition
# is broken on Tahoe). App->space is handled natively: Dock icon > Options >
# Assign To > This Desktop.
source "${config_dir}/settings.sh"     # tiling layout, padding, gaps
source "${config_dir}/mouse.sh"        # pointer behavior
source "${config_dir}/rules.sh"        # unmanaged apps

echo "yabai configuration loaded"
